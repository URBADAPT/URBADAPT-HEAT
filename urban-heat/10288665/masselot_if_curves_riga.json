{
  "age_65plus_composition": "dynamic: 2030-2050 65+ curves recomposed from 65-74/75-84/85+ curves, each scaled by its own WCDE death-rate trend and weighted by its projected share of 65+ (baseline_heat_subband_riga.csv)",
  "reference_year": 2020,
  "years": [
    2020,
    2030,
    2040,
    2050
